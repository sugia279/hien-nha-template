---
import Banner from '@hien-nha/core-ui/Banner.astro';
import ProfileIdentity from '@hien-nha/core-ui/ProfileIdentity.astro';
import { sitePath } from '@hien-nha/core-config';
import type { PublicPost } from '@hien-nha/core-domain';
import Frame from '../components/Frame.astro';
import Search from '../components/Search.astro';
import { data, ownerPreview } from '../data.mjs';
const { site, hosting, posts } = data,
  p = site.presentation,
  vi = p.locale === 'vi';
---

<Frame site={site} hosting={hosting}>
  <Banner
    headingId="site-heading"
    banner={p.banner}
    hosting={hosting}
    title={p.name}
    tagline={p.tagline}
  >
    <ProfileIdentity profile={p.profile} hosting={hosting} showName={true} />
  </Banner>
  {p.modules.includes('posts') && (
    <section class="post-list" aria-labelledby="posts-heading">
      <h2 class="section-label" id="posts-heading">
        {vi ? 'Những trang viết' : 'Stories from home'}
      </h2>
      {posts.length === 0 ? (
        <p class="empty">
          {vi
            ? 'Chưa có bài viết công khai. Hẹn gặp bạn ở câu chuyện đầu tiên.'
            : 'No public stories yet. Come back for the first one.'}
        </p>
      ) : (
        <div class="posts">
          {posts.map((post: PublicPost) => (
            <article class="post-card">
              <h3>
                <a href={sitePath(hosting, 'posts/' + post.id + '/')}>
                  {post.title}
                </a>
              </h3>
              <p class="excerpt">
                {post.body.slice(0, 220)}
                {post.body.length > 220 ? '…' : ''}
              </p>
              <a
                class="read-more"
                href={sitePath(hosting, 'posts/' + post.id + '/')}
              >
                {vi ? 'Đọc câu chuyện' : 'Read the story'}{' '}
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      )}
    </section>
  )}
  {p.modules.includes('posts') && !ownerPreview && <Search />}
</Frame>
